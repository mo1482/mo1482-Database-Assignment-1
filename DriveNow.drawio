        <mxCell id="4BusinessRules_73" value="WHY SIMPLE CONSTRAINTS ARE NOT ENOUGH" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontSize=13;fontFamily=Arial;fontColor=#8A562C;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="102" y="2594" width="1745" height="25" as="geometry" />
        </mxCell>
        <mxCell id="4BusinessRules_74" value="الـFK والـNN يمنعان رقمًا بلا مالك، لكنهما لا يفرضان وجود صف تابع واحد على الأقل لكل فرع أو عميل." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=14;fontFamily=Arial;fontColor=#263746;" vertex="1" parent="1">
          <mxGeometry x="102" y="2621" width="1745" height="100" as="geometry" />
