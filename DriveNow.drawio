        </mxCell>
        <mxCell id="4BusinessRules_54" value="7  |  §7.3 Vehicle status audit" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#E7F0F8;strokeColor=#AABAC8;strokeWidth=1;fontSize=18;fontFamily=Arial;fontColor=#172B4D;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="92" y="1837" width="1776" height="44" as="geometry" />
        </mxCell>
        <mxCell id="4BusinessRules_55" value="RULE" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontSize=13;fontFamily=Arial;fontColor=#255B7E;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="102" y="1891" width="170" height="24" as="geometry" />
        </mxCell>
        <mxCell id="4BusinessRules_56" value="كل تغيير لحالة المركبة يجب أن يُسجل كسجل تاريخي مع الموظف والتوقيت، ويجب أن تعكس حالة المركبة الحالية أحدث سجل حالة." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=15;fontFamily=Arial;fontColor=#263746;" vertex="1" parent="1">
          <mxGeometry x="102" y="1915" width="1745" height="116" as="geometry" />
        </mxCell>
        <mxCell id="4BusinessRules_57" value="WHY SIMPLE CONSTRAINTS ARE NOT ENOUGH" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontSize=13;fontFamily=Arial;fontColor=#8A562C;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="102" y="2039" width="1745" height="25" as="geometry" />
        </mxCell>
        <mxCell id="4BusinessRules_58" value="القاعدة تعتمد على إضافة صف في VEHICLE_STATUS_HISTORY ثم مزامنة VEHICLE أو اشتقاق الحالة من أحدث حدث؛ CHECK لا يستطيع فرض اتساق جدولين أو ضمان وجود حدث لكل تعديل." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=14;fontFamily=Arial;fontColor=#263746;" vertex="1" parent="1">
          <mxGeometry x="102" y="2066" width="1745" height="100" as="geometry" />
        </mxCell>
        <mxCell id="4BusinessRules_59" value="ENFORCEMENT" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontSize=13;fontFamily=Arial;fontColor=#427A66;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="102" y="2175" width="1745" height="24" as="geometry" />
        </mxCell>
        <mxCell id="4BusinessRules_60" value="منع تعديل CurrentStatus مباشرة؛ Stored procedure ChangeVehicleStatus تضيف سجلًا ثم تحدث الحالة الحالية في VEHICLE داخل transaction. Trigger يرفض أي تحديث بلا سجل مرتبط." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=14;fontFamily=Arial;fontColor=#263746;" vertex="1" parent="1">
          <mxGeometry x="102" y="2200" width="1745" height="120" as="geometry" />
        </mxCell>
        <mxCell id="4BusinessRules_61" value="" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#F8FAFC;strokeColor=#B7C4CE;strokeWidth=1.2;fontSize=20;fontFamily=Arial;fontColor=#172B4D;" vertex="1" parent="1">
          <mxGeometry x="1980" y="1825" width="1800" height="510" as="geometry" />
        </mxCell>
        <mxCell id="4BusinessRules_62" value="8  |  §7.1 Employee roles" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#E7F0F8;strokeColor=#AABAC8;strokeWidth=1;fontSize=18;fontFamily=Arial;fontColor=#172B4D;fontStyle=1;" vertex="1" parent="1">
