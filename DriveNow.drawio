        </mxCell>
        <mxCell id="4BusinessRules_82" value="التحقق يتطلب فحص نوع العميل ومطابقة مفتاح الشركة مع AUTHORIZED_DRIVER؛ لا يكفي CHECK على أعمدة RENTAL وحدها." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=14;fontFamily=Arial;fontColor=#263746;" vertex="1" parent="1">
