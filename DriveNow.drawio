        <mxCell id="4BusinessRules_70" value="9  |  §7.1 + §7.7 Contact phones" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#E7F0F8;strokeColor=#AABAC8;strokeWidth=1;fontSize=18;fontFamily=Arial;fontColor=#172B4D;fontStyle=1;" vertex="1" parent="1">
