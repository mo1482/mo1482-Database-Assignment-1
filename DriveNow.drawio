  <diagram id="3QuestionsAssumptions" name="3-Questions-Assumptions">
    <mxGraphModel dx="4478" dy="2443" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="3900" pageHeight="2650" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="u47Cr1O6A8BQdtGGAksK-1" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontStyle=1;" value="&lt;b&gt;DriveNow — Mohamed Ibrahim Fathy Metwally Awad | Group/ID: ADD YOUR GROUP &amp; ID&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;SRS DN-SRS-2026-01 • Chen-style conceptual model / relational design&lt;/font&gt;" vertex="1">
          <mxGeometry height="202" width="1500" x="930" y="68" as="geometry" />
        </mxCell>
        <mxCell id="u47Cr1O6A8BQdtGGAksK-2" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;" value="QUESTIONS (SRS section)" vertex="1">
          <mxGeometry height="34" width="1490" x="940" y="283" as="geometry" />
        </mxCell>
        <mxCell id="u47Cr1O6A8BQdtGGAksK-3" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;" value="1. §7.1: Can a branch have more than one manager over time, and is manager history required beyond the current StartDate?" vertex="1">
          <mxGeometry height="34" width="1490" x="940" y="321" as="geometry" />
        </mxCell>
        <mxCell id="u47Cr1O6A8BQdtGGAksK-4" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;" value="2. §7.1: What is the precise definition of senior management for nullable SupervisorID?" vertex="1">
          <mxGeometry height="34" width="1490" x="940" y="359" as="geometry" />
        </mxCell>
        <mxCell id="u47Cr1O6A8BQdtGGAksK-5" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;" value="3. §7.2: Can an employee enroll in the same course multiple times after passing, or only after failing?" vertex="1">
          <mxGeometry height="34" width="1490" x="940" y="397" as="geometry" />
        </mxCell>
        <mxCell id="u47Cr1O6A8BQdtGGAksK-6" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;" value="4. §7.3: Does a vehicle with a special daily price always override its category rate, and are special prices also effective-dated?" vertex="1">
          <mxGeometry height="34" width="1490" x="940" y="435" as="geometry" />
        </mxCell>
        <mxCell id="u47Cr1O6A8BQdtGGAksK-7" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;" value="5. §7.5: Can a GPS device be removed and reinstalled in another vehicle? Is full installation history required?" vertex="1">
          <mxGeometry height="34" width="1490" x="940" y="473" as="geometry" />
        </mxCell>
        <mxCell id="u47Cr1O6A8BQdtGGAksK-8" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;" value="6. §7.7: For Egyptian individuals, is NationalID mandatory and PassportNo forbidden (and vice versa for foreigners)?" vertex="1">
          <mxGeometry height="34" width="1490" x="940" y="511" as="geometry" />
        </mxCell>
        <mxCell id="u47Cr1O6A8BQdtGGAksK-9" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;" value="7. §7.7: Can a customer be blacklisted more than once, or should only the latest decision be stored?" vertex="1">
          <mxGeometry height="34" width="1490" x="940" y="549" as="geometry" />
        </mxCell>
        <mxCell id="u47Cr1O6A8BQdtGGAksK-10" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;" value="8. §7.11–7.12: Can a cancelled/no-show reservation ever be converted into a rental?" vertex="1">
          <mxGeometry height="34" width="1490" x="940" y="587" as="geometry" />
        </mxCell>
        <mxCell id="u47Cr1O6A8BQdtGGAksK-11" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;" value="9. §7.12: How is the corporate main authorized driver referenced, and must it belong to the rental&#39;s corporate customer?" vertex="1">
          <mxGeometry height="34" width="1490" x="940" y="625" as="geometry" />
        </mxCell>
        <mxCell id="u47Cr1O6A8BQdtGGAksK-12" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;" value="10. §7.12: What formula/rate determines late fees and additional-driver fees?" vertex="1">
          <mxGeometry height="34" width="1490" x="940" y="663" as="geometry" />
        </mxCell>
        <mxCell id="u47Cr1O6A8BQdtGGAksK-13" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;" value="11. §7.13: Can the same insurance package be added more than once to one rental?" vertex="1">
          <mxGeometry height="34" width="1490" x="940" y="701" as="geometry" />
        </mxCell>
        <mxCell id="u47Cr1O6A8BQdtGGAksK-14" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;" value="12. §7.14: Is violation number globally unique, or unique only within the issuing authority?" vertex="1">
          <mxGeometry height="34" width="1490" x="940" y="739" as="geometry" />
        </mxCell>
        <mxCell id="u47Cr1O6A8BQdtGGAksK-15" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;" value="13. §7.15: Can a maintenance job be linked to multiple damage reports, or exactly one?" vertex="1">
          <mxGeometry height="34" width="1490" x="940" y="777" as="geometry" />
        </mxCell>
        <mxCell id="u47Cr1O6A8BQdtGGAksK-16" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;" value="14. §7.16: How are corporate monthly invoices paid and allocated to their constituent rentals?" vertex="1">
          <mxGeometry height="34" width="1490" x="940" y="815" as="geometry" />
        </mxCell>
        <mxCell id="u47Cr1O6A8BQdtGGAksK-17" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;" value="15. §7.16: Are transaction references required for every card/bank payment and prohibited for cash?" vertex="1">
          <mxGeometry height="34" width="1490" x="940" y="853" as="geometry" />
        </mxCell>
        <mxCell id="u47Cr1O6A8BQdtGGAksK-18" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;" value="16. §7.10: What is the points earning/redemption conversion rule and can points expire?" vertex="1">
          <mxGeometry height="34" width="1490" x="940" y="891" as="geometry" />
        </mxCell>
        <mxCell id="u47Cr1O6A8BQdtGGAksK-19" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;" value="ASSUMPTIONS (explicit design choices)" vertex="1">
          <mxGeometry height="34" width="1490" x="940" y="929" as="geometry" />
        </mxCell>
        <mxCell id="u47Cr1O6A8BQdtGGAksK-20" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;" value="1. §7.1: BranchCode, EmployeeID and other business identifiers are stable primary keys; email and national ID are unique." vertex="1">
          <mxGeometry height="34" width="1490" x="940" y="967" as="geometry" />
        </mxCell>
        <mxCell id="u47Cr1O6A8BQdtGGAksK-21" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;" value="2. §7.1: Employee may have zero or one supervisor; senior management has NULL SupervisorID. Agent and Mechanic subtypes are disjoint and partial." vertex="1">
          <mxGeometry height="34" width="1490" x="940" y="1005" as="geometry" />
        </mxCell>
        <mxCell id="u47Cr1O6A8BQdtGGAksK-22" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;" value="3. §7.1: A branch has exactly one current manager; manager assignment history is not fully modeled, so BranchManager stores the current assignment and StartDate." vertex="1">
          <mxGeometry height="34" width="1490" x="940" y="1043" as="geometry" />
        </mxCell>
        <mxCell id="u47Cr1O6A8BQdtGGAksK-23" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;" value="4. §7.2: Each course attempt is identified by (EmployeeID, CourseCode, AttemptNo); every repeat is retained." vertex="1">
          <mxGeometry height="34" width="1490" x="940" y="1081" as="geometry" />
        </mxCell>
        <mxCell id="u47Cr1O6A8BQdtGGAksK-24" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;" value="5. §7.3: Category rates are non-overlapping validity periods; a vehicle-specific SpecialDailyPrice overrides category pricing when present." vertex="1">
          <mxGeometry height="34" width="1490" x="940" y="1119" as="geometry" />
        </mxCell>
        <mxCell id="u47Cr1O6A8BQdtGGAksK-25" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;" value="6. §7.5: Each device is installed in at most one vehicle at a time; GPS_INSTALLATION models current installation only, pending clarification on history." vertex="1">
          <mxGeometry height="34" width="1490" x="940" y="1157" as="geometry" />
        </mxCell>
        <mxCell id="u47Cr1O6A8BQdtGGAksK-26" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;" value="7. §7.7: Individual/Corporate customer subtypes are total and disjoint. AuthorizedDriver is weak under CorporateCustomer, identified by company + internal driver number." vertex="1">
          <mxGeometry height="34" width="1490" x="940" y="1195" as="geometry" />
        </mxCell>
        <mxCell id="u47Cr1O6A8BQdtGGAksK-27" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;" value="8. §7.7: Blacklist stores one current blacklist decision per customer; re-blacklisting/history requires a separate history table if needed." vertex="1">
          <mxGeometry height="34" width="1490" x="940" y="1233" as="geometry" />
        </mxCell>
        <mxCell id="u47Cr1O6A8BQdtGGAksK-28" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;" value="9. §7.10: LoyaltyAccount applies only to IndividualCustomer; points balance and tier are derived from movements, not manually entered." vertex="1">
          <mxGeometry height="34" width="1490" x="940" y="1271" as="geometry" />
        </mxCell>
        <mxCell id="u47Cr1O6A8BQdtGGAksK-29" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;" value="10. §7.12: Rental.ReservationNo is nullable and unique; each reservation creates zero or one rental. Walk-in rentals have NULL ReservationNo." vertex="1">
          <mxGeometry height="34" width="1490" x="940" y="1309" as="geometry" />
        </mxCell>
        <mxCell id="u47Cr1O6A8BQdtGGAksK-30" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;" value="11. §7.12: MainAuthorizedDriverNo is populated only for corporate rentals and refers to an AuthorizedDriver belonging to the same corporate customer (enforce via composite FK/application logic)." vertex="1">
          <mxGeometry height="34" width="1490" x="940" y="1347" as="geometry" />
        </mxCell>
        <mxCell id="u47Cr1O6A8BQdtGGAksK-31" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;" value="12. §7.14: DamageReport is weak under Rental with key (RentalNo, ReportNo); photos are a multivalued attribute mapped to DamagePhoto." vertex="1">
          <mxGeometry height="34" width="1490" x="940" y="1385" as="geometry" />
        </mxCell>
        <mxCell id="u47Cr1O6A8BQdtGGAksK-32" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;" value="13. §7.15: A maintenance job references at most one damage report; damage report causes at most one repair job." vertex="1">
          <mxGeometry height="34" width="1490" x="940" y="1423" as="geometry" />
        </mxCell>
        <mxCell id="u47Cr1O6A8BQdtGGAksK-33" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;" value="14. §7.16: Corporate invoices group rentals for a corporate customer and billing period; payment allocation/invoice payment extension is not specified and needs confirmation." vertex="1">
          <mxGeometry height="34" width="1490" x="940" y="1461" as="geometry" />
        </mxCell>
        <mxCell id="u47Cr1O6A8BQdtGGAksK-34" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;" value="CONTRADICTIONS / GAPS" vertex="1">
          <mxGeometry height="34" width="1490" x="940" y="1499" as="geometry" />
        </mxCell>
        <mxCell id="u47Cr1O6A8BQdtGGAksK-35" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;" value="1. §7.3 says rates are per category and historical; COO note says some luxury vehicles have their own price. Resolved by optional Vehicle.SpecialDailyPrice override; effective dates for overrides remain unspecified." vertex="1">
          <mxGeometry height="34" width="1490" x="940" y="1537" as="geometry" />
        </mxCell>
        <mxCell id="u47Cr1O6A8BQdtGGAksK-36" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;" value="2. §7.16 says rentals may have several payments, while Finance says corporate clients are invoiced monthly rather than paying per rental. Model keeps Rental payments for direct payments and adds monthly CorporateInvoice / InvoiceRental; invoice-level payments need clarification." vertex="1">
          <mxGeometry height="34" width="1490" x="940" y="1575" as="geometry" />
        </mxCell>
        <mxCell id="u47Cr1O6A8BQdtGGAksK-37" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;" value="3. §7.1 says every branch has one manager and is never without one, but a manager can resign and regional director temporarily takes over. The SRS does not define whether regional director must be represented as a branch employee/manager assignment or whether manager history is required." vertex="1">
          <mxGeometry height="34" width="1490" x="940" y="1613" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="4BusinessRules" name="4-Business-Rules">
    <mxGraphModel dx="1800" dy="1000" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="3900" pageHeight="3750" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="4BusinessRules_2" value="DRIVENOW • PART D — BUSINESS RULES BEYOND SIMPLE CONSTRAINTS" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontSize=27;fontFamily=Arial;fontColor=#193B5A;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="80" y="18" width="3600" height="42" as="geometry" />
        </mxCell>
        <mxCell id="4BusinessRules_3" value="Prepared by: [YOUR NAME]   |   Group: [FILL]   |   ID: [FILL]" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontSize=15;fontFamily=Arial;fontColor=#526579;" vertex="1" parent="1">
          <mxGeometry x="80" y="64" width="3000" height="30" as="geometry" />
        </mxCell>
        <mxCell id="4BusinessRules_4" value="هذه قواعد تعتمد على أكثر من صف أو جدول أو حالة زمنية؛ لا يكفي لها PK / FK / NN / UQ / CHECK / DEFAULT وحدها." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontSize=15;fontFamily=Arial;fontColor=#526579;" vertex="1" parent="1">
          <mxGeometry x="80" y="100" width="3700" height="32" as="geometry" />
        </mxCell>
        <mxCell id="4BusinessRules_5" value="" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#F8FAFC;strokeColor=#B7C4CE;strokeWidth=1.2;fontSize=20;fontFamily=Arial;fontColor=#172B4D;" vertex="1" parent="1">
          <mxGeometry x="80" y="160" width="1800" height="510" as="geometry" />
        </mxCell>
        <mxCell id="4BusinessRules_6" value="1  |  §7.6 Vehicle Transfer" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#E7F0F8;strokeColor=#AABAC8;strokeWidth=1;fontSize=18;fontFamily=Arial;fontColor=#172B4D;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="92" y="172" width="1776" height="44" as="geometry" />
        </mxCell>
        <mxCell id="4BusinessRules_7" value="RULE" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontSize=13;fontFamily=Arial;fontColor=#255B7E;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="102" y="226" width="170" height="24" as="geometry" />
        </mxCell>
        <mxCell id="4BusinessRules_8" value="لا يُقبل نقل مركبة إلا إذا كان FromBranch هو موقعها الحالي، ويجب أن يكون مختلفًا عن ToBranch. بعد تسجيل النقل يُحدّث CurrentBranchCode ويُحفظ سجل النقل والسائق والعداد كوحدة واحدة." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=15;fontFamily=Arial;fontColor=#263746;" vertex="1" parent="1">
          <mxGeometry x="102" y="250" width="1745" height="116" as="geometry" />
        </mxCell>
        <mxCell id="4BusinessRules_9" value="WHY SIMPLE CONSTRAINTS ARE NOT ENOUGH" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontSize=13;fontFamily=Arial;fontColor=#8A562C;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="102" y="374" width="1745" height="25" as="geometry" />
        </mxCell>
        <mxCell id="4BusinessRules_10" value="CHECK يستطيع منع FromBranch = ToBranch فقط؛ لكنه لا يستطيع مقارنة FromBranch بالموقع الحالي المخزن في صف VEHICLE ثم تحديث صف آخر وتسجيل سجل تاريخي." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=14;fontFamily=Arial;fontColor=#263746;" vertex="1" parent="1">
          <mxGeometry x="102" y="401" width="1745" height="100" as="geometry" />
        </mxCell>
        <mxCell id="4BusinessRules_11" value="ENFORCEMENT" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontSize=13;fontFamily=Arial;fontColor=#427A66;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="102" y="510" width="1745" height="24" as="geometry" />
        </mxCell>
        <mxCell id="4BusinessRules_12" value="Stored procedure TransferVehicle تنفّذ transaction: تقفل صف VEHICLE، تتحقق من CurrentBranchCode والعداد، تضيف VEHICLE_TRANSFER، ثم تحدّث CurrentBranchCode. Trigger كحاجز إضافي." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=14;fontFamily=Arial;fontColor=#263746;" vertex="1" parent="1">
          <mxGeometry x="102" y="535" width="1745" height="120" as="geometry" />
        </mxCell>
        <mxCell id="4BusinessRules_13" value="" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#F8FAFC;strokeColor=#B7C4CE;strokeWidth=1.2;fontSize=20;fontFamily=Arial;fontColor=#172B4D;" vertex="1" parent="1">
          <mxGeometry x="1980" y="160" width="1800" height="510" as="geometry" />
        </mxCell>
        <mxCell id="4BusinessRules_14" value="2  |  §7.7 + §7.11 Blacklist" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#E7F0F8;strokeColor=#AABAC8;strokeWidth=1;fontSize=18;fontFamily=Arial;fontColor=#172B4D;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1992" y="172" width="1776" height="44" as="geometry" />
        </mxCell>
        <mxCell id="4BusinessRules_15" value="RULE" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontSize=13;fontFamily=Arial;fontColor=#255B7E;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="2002" y="226" width="170" height="24" as="geometry" />
        </mxCell>
        <mxCell id="4BusinessRules_16" value="لا يجوز إنشاء Reservation لعميل لديه سجل Blacklist نشط." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=15;fontFamily=Arial;fontColor=#263746;" vertex="1" parent="1">
          <mxGeometry x="2002" y="250" width="1745" height="116" as="geometry" />
        </mxCell>
        <mxCell id="4BusinessRules_17" value="WHY SIMPLE CONSTRAINTS ARE NOT ENOUGH" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontSize=13;fontFamily=Arial;fontColor=#8A562C;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="2002" y="374" width="1745" height="25" as="geometry" />
        </mxCell>
        <mxCell id="4BusinessRules_18" value="الشرط يعتمد على وجود سجل في جدول BLACKLIST وقت إدخال RESERVATION؛ لا يمكن لـCHECK العادي قراءة جدول آخر." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=14;fontFamily=Arial;fontColor=#263746;" vertex="1" parent="1">
          <mxGeometry x="2002" y="401" width="1745" height="100" as="geometry" />
        </mxCell>
        <mxCell id="4BusinessRules_19" value="ENFORCEMENT" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontSize=13;fontFamily=Arial;fontColor=#427A66;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="2002" y="510" width="1745" height="24" as="geometry" />
        </mxCell>
        <mxCell id="4BusinessRules_20" value="Stored procedure CreateReservation تتحقق من عدم وجود BLACKLIST.IsActive=1 قبل الإدراج، مع transaction/locking لتفادي السباق. Trigger يمنع الإدراج المباشر غير المصرح." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=14;fontFamily=Arial;fontColor=#263746;" vertex="1" parent="1">
          <mxGeometry x="2002" y="535" width="1745" height="120" as="geometry" />
        </mxCell>
        <mxCell id="4BusinessRules_21" value="" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#F8FAFC;strokeColor=#B7C4CE;strokeWidth=1.2;fontSize=20;fontFamily=Arial;fontColor=#172B4D;" vertex="1" parent="1">
          <mxGeometry x="80" y="715" width="1800" height="510" as="geometry" />
        </mxCell>
        <mxCell id="4BusinessRules_22" value="3  |  §7.1 Manager history" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#E7F0F8;strokeColor=#AABAC8;strokeWidth=1;fontSize=18;fontFamily=Arial;fontColor=#172B4D;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="92" y="727" width="1776" height="44" as="geometry" />
        </mxCell>
        <mxCell id="4BusinessRules_23" value="RULE" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontSize=13;fontFamily=Arial;fontColor=#255B7E;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="102" y="781" width="170" height="24" as="geometry" />
        </mxCell>
        <mxCell id="4BusinessRules_24" value="لا تتداخل فترات إدارة الفروع: لا يدير موظف فرعين في نفس الوقت، ولا يكون للفرع مديرَان خلال الفترة نفسها، ولا توجد فجوة تغيب فيها الإدارة." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=15;fontFamily=Arial;fontColor=#263746;" vertex="1" parent="1">
          <mxGeometry x="102" y="805" width="1745" height="116" as="geometry" />
        </mxCell>
        <mxCell id="4BusinessRules_25" value="WHY SIMPLE CONSTRAINTS ARE NOT ENOUGH" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontSize=13;fontFamily=Arial;fontColor=#8A562C;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="102" y="929" width="1745" height="25" as="geometry" />
        </mxCell>
        <mxCell id="4BusinessRules_26" value="هذه قيود على تداخل نطاقات تواريخ بين صفوف متعددة؛ ليست CHECK على صف واحد." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=14;fontFamily=Arial;fontColor=#263746;" vertex="1" parent="1">
          <mxGeometry x="102" y="956" width="1745" height="100" as="geometry" />
        </mxCell>
        <mxCell id="4BusinessRules_27" value="ENFORCEMENT" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontSize=13;fontFamily=Arial;fontColor=#427A66;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="102" y="1065" width="1745" height="24" as="geometry" />
        </mxCell>
        <mxCell id="4BusinessRules_28" value="Stored procedure AssignBranchManager تفحص التداخل للفرع والموظف وتغلق التكليف السابق وتضيف الجديد داخل transaction. تقرير تدقيق يومي يكشف أي فجوة." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=14;fontFamily=Arial;fontColor=#263746;" vertex="1" parent="1">
          <mxGeometry x="102" y="1090" width="1745" height="120" as="geometry" />
        </mxCell>
        <mxCell id="4BusinessRules_29" value="" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#F8FAFC;strokeColor=#B7C4CE;strokeWidth=1.2;fontSize=20;fontFamily=Arial;fontColor=#172B4D;" vertex="1" parent="1">
          <mxGeometry x="1980" y="715" width="1800" height="510" as="geometry" />
        </mxCell>
        <mxCell id="4BusinessRules_30" value="4  |  §7.10 Loyalty" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#E7F0F8;strokeColor=#AABAC8;strokeWidth=1;fontSize=18;fontFamily=Arial;fontColor=#172B4D;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1992" y="727" width="1776" height="44" as="geometry" />
        </mxCell>
        <mxCell id="4BusinessRules_31" value="RULE" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontSize=13;fontFamily=Arial;fontColor=#255B7E;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="2002" y="781" width="170" height="24" as="geometry" />
        </mxCell>
        <mxCell id="4BusinessRules_32" value="لا يسمح باستبدال نقاط إذا كان رصيد العميل بعد العملية سيصبح سالبًا؛ ويُحسب Silver/Gold/Platinum من إجمالي الحركات تلقائيًا." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=15;fontFamily=Arial;fontColor=#263746;" vertex="1" parent="1">
          <mxGeometry x="2002" y="805" width="1745" height="116" as="geometry" />
        </mxCell>
        <mxCell id="4BusinessRules_33" value="WHY SIMPLE CONSTRAINTS ARE NOT ENOUGH" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontSize=13;fontFamily=Arial;fontColor=#8A562C;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="2002" y="929" width="1745" height="25" as="geometry" />
        </mxCell>
        <mxCell id="4BusinessRules_34" value="الرصيد ناتج من SUM لعدة صفوف في LOYALTY_MOVEMENT، والـTier يعتمد على ذلك الناتج؛ لا يمكن ضمانه بـCHECK صفّي." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=14;fontFamily=Arial;fontColor=#263746;" vertex="1" parent="1">
          <mxGeometry x="2002" y="956" width="1745" height="100" as="geometry" />
        </mxCell>
        <mxCell id="4BusinessRules_35" value="ENFORCEMENT" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontSize=13;fontFamily=Arial;fontColor=#427A66;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="2002" y="1065" width="1745" height="24" as="geometry" />
        </mxCell>
        <mxCell id="4BusinessRules_36" value="Stored procedure RedeemPoints تقرأ الرصيد بقفل مناسب ثم تسجل الحركة؛ View تحسب الرصيد والـTier، أو trigger يحدث projection ماديًا ضمن transaction." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=14;fontFamily=Arial;fontColor=#263746;" vertex="1" parent="1">
          <mxGeometry x="2002" y="1090" width="1745" height="120" as="geometry" />
        </mxCell>
        <mxCell id="4BusinessRules_37" value="" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#F8FAFC;strokeColor=#B7C4CE;strokeWidth=1.2;fontSize=20;fontFamily=Arial;fontColor=#172B4D;" vertex="1" parent="1">
          <mxGeometry x="80" y="1270" width="1800" height="510" as="geometry" />
        </mxCell>
        <mxCell id="4BusinessRules_38" value="5  |  §7.3 / §7.4 / §7.13 Pricing" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#E7F0F8;strokeColor=#AABAC8;strokeWidth=1;fontSize=18;fontFamily=Arial;fontColor=#172B4D;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="92" y="1282" width="1776" height="44" as="geometry" />
        </mxCell>
        <mxCell id="4BusinessRules_39" value="RULE" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontSize=13;fontFamily=Arial;fontColor=#255B7E;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="102" y="1336" width="170" height="24" as="geometry" />
        </mxCell>
        <mxCell id="4BusinessRules_40" value="يجب اختيار السعر الساري في تاريخ الحجز/الإيجار، ومنع تداخل فترات الأسعار، وتخزين السعر الذي تم تحصيله فعلًا على العقد." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=15;fontFamily=Arial;fontColor=#263746;" vertex="1" parent="1">
          <mxGeometry x="102" y="1360" width="1745" height="116" as="geometry" />
        </mxCell>
        <mxCell id="4BusinessRules_41" value="WHY SIMPLE CONSTRAINTS ARE NOT ENOUGH" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontSize=13;fontFamily=Arial;fontColor=#8A562C;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="102" y="1484" width="1745" height="25" as="geometry" />
        </mxCell>
        <mxCell id="4BusinessRules_42" value="اختيار آخر سعر ساري يتطلب قراءة سجل تاريخي؛ وعدم تداخل الفترات يقارن صفوفًا متعددة؛ كما أن القيمة المحصلة لقطة زمنية." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=14;fontFamily=Arial;fontColor=#263746;" vertex="1" parent="1">
          <mxGeometry x="102" y="1511" width="1745" height="100" as="geometry" />
        </mxCell>
        <mxCell id="4BusinessRules_43" value="ENFORCEMENT" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontSize=13;fontFamily=Arial;fontColor=#427A66;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="102" y="1620" width="1745" height="24" as="geometry" />
        </mxCell>
        <mxCell id="4BusinessRules_44" value="Stored procedure QuoteRental تختار CATEGORY_RATE / EXTRA_RATE / INSURANCE_RATE الساري، وتنسخ السعر إلى AppliedDailyRate وChargedDailyRate وChargedDailyPrice. Trigger يمنع تداخل فترات التعريفة." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=14;fontFamily=Arial;fontColor=#263746;" vertex="1" parent="1">
          <mxGeometry x="102" y="1645" width="1745" height="120" as="geometry" />
        </mxCell>
        <mxCell id="4BusinessRules_45" value="" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#F8FAFC;strokeColor=#B7C4CE;strokeWidth=1.2;fontSize=20;fontFamily=Arial;fontColor=#172B4D;" vertex="1" parent="1">
          <mxGeometry x="1980" y="1270" width="1800" height="510" as="geometry" />
        </mxCell>
        <mxCell id="4BusinessRules_46" value="6  |  §7.12 Rental extension" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#E7F0F8;strokeColor=#AABAC8;strokeWidth=1;fontSize=18;fontFamily=Arial;fontColor=#172B4D;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1992" y="1282" width="1776" height="44" as="geometry" />
        </mxCell>
        <mxCell id="4BusinessRules_47" value="RULE" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontSize=13;fontFamily=Arial;fontColor=#255B7E;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="2002" y="1336" width="170" height="24" as="geometry" />
        </mxCell>
        <mxCell id="4BusinessRules_48" value="كل Rental يمكن أن يُمدد مرة واحدة فقط مباشرة، ولا يجوز إنشاء حلقات في سلسلة التمديد." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=15;fontFamily=Arial;fontColor=#263746;" vertex="1" parent="1">
          <mxGeometry x="2002" y="1360" width="1745" height="116" as="geometry" />
        </mxCell>
        <mxCell id="4BusinessRules_49" value="WHY SIMPLE CONSTRAINTS ARE NOT ENOUGH" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontSize=13;fontFamily=Arial;fontColor=#8A562C;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="2002" y="1484" width="1745" height="25" as="geometry" />
        </mxCell>
        <mxCell id="4BusinessRules_50" value="UQ(PreviousRentalNo) يضمن ابنًا مباشرًا واحدًا، لكنه لا يمنع دورة متعددة الصفوف مثل A→B→C→A." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=14;fontFamily=Arial;fontColor=#263746;" vertex="1" parent="1">
          <mxGeometry x="2002" y="1511" width="1745" height="100" as="geometry" />
        </mxCell>
        <mxCell id="4BusinessRules_51" value="ENFORCEMENT" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontSize=13;fontFamily=Arial;fontColor=#427A66;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="2002" y="1620" width="1745" height="24" as="geometry" />
        </mxCell>
        <mxCell id="4BusinessRules_52" value="Stored procedure ExtendRental تتحقق من أن الأصل ليس له امتداد سابق، وأن السلسلة لا تحتوي RentalNo الجديد، ثم تحفظ الاتفاقية الجديدة. UQ يبقى كحماية إضافية." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=14;fontFamily=Arial;fontColor=#263746;" vertex="1" parent="1">
          <mxGeometry x="2002" y="1645" width="1745" height="120" as="geometry" />
        </mxCell>
        <mxCell id="4BusinessRules_53" value="" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#F8FAFC;strokeColor=#B7C4CE;strokeWidth=1.2;fontSize=20;fontFamily=Arial;fontColor=#172B4D;" vertex="1" parent="1">
