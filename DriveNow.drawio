        <mxCell id="4BusinessRules_76" value="Stored procedure CreateBranch/CreateCustomer تضيف السجل ورقم الهاتف في transaction واحدة؛ Trigger يمنع حذف آخر رقم مرتبط.&amp;lt;br&amp;gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=14;fontFamily=Arial;fontColor=#263746;" vertex="1" parent="1">
