        </mxCell>
        <mxCell id="4BusinessRules_72" value="كل فرع وكل عميل يجب أن يمتلك رقم هاتف واحدًا على الأقل؛ جداول BRANCH_PHONE وCUSTOMER_PHONE تسمح بوجود عدة أرقام." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=15;fontFamily=Arial;fontColor=#263746;" vertex="1" parent="1">
          <mxGeometry x="102" y="2470" width="1745" height="116" as="geometry" />
