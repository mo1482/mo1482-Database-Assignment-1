        </mxCell>
        <mxCell id="4BusinessRules_80" value="كل إيجار لعميل شركة يجب أن يحدد سائقًا معتمدًا تابعًا لنفس الشركة؛ الإيجار الفردي لا يحتاج AuthorizedDriver." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=15;fontFamily=Arial;fontColor=#263746;" vertex="1" parent="1">
          <mxGeometry x="2002" y="2470" width="1745" height="116" as="geometry" />
        </mxCell>
        <mxCell id="4BusinessRules_81" value="WHY SIMPLE CONSTRAINTS ARE NOT ENOUGH" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontSize=13;fontFamily=Arial;fontColor=#8A562C;fontStyle=1;" vertex="1" parent="1">
