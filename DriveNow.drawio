        <mxCell id="4BusinessRules_63" value="RULE" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontSize=13;fontFamily=Arial;fontColor=#255B7E;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="2002" y="1891" width="170" height="24" as="geometry" />
        </mxCell>
        <mxCell id="4BusinessRules_64" value="لا يجوز للموظف أن يكون RentalAgent وMechanic في الوقت نفسه." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=15;fontFamily=Arial;fontColor=#263746;" vertex="1" parent="1">
          <mxGeometry x="2002" y="1915" width="1745" height="116" as="geometry" />
        </mxCell>
        <mxCell id="4BusinessRules_65" value="WHY SIMPLE CONSTRAINTS ARE NOT ENOUGH" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontSize=13;fontFamily=Arial;fontColor=#8A562C;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="2002" y="2039" width="1745" height="25" as="geometry" />
        </mxCell>
        <mxCell id="4BusinessRules_66" value="عدم الجمع بين نوعين يعتمد على وجود صف في جدول subtype آخر؛ لا يمكن لـCHECK العادي فحص وجود صف في جدول subtype آخر." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=14;fontFamily=Arial;fontColor=#263746;" vertex="1" parent="1">
          <mxGeometry x="2002" y="2066" width="1745" height="100" as="geometry" />
        </mxCell>
        <mxCell id="4BusinessRules_67" value="ENFORCEMENT" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontSize=13;fontFamily=Arial;fontColor=#427A66;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="2002" y="2175" width="1745" height="24" as="geometry" />
        </mxCell>
        <mxCell id="4BusinessRules_68" value="Trigger أو إجراءات تعيين منفصلة تتحقق من تعارض subtype قبل إدراج سجل RENTAL_AGENT أو MECHANIC." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;strokeColor=none;fillColor=none;fontSize=14;fontFamily=Arial;fontColor=#263746;" vertex="1" parent="1">
