        <mxCell id="4BusinessRules_79" value="RULE" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontSize=13;fontFamily=Arial;fontColor=#255B7E;fontStyle=1;" vertex="1" parent="1">
